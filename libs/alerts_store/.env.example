# Copy to .env (gitignored) on each deployment and set the real host paths.
# These are the directories on the host that hold the stored alerts, one per schema era.
# If unset, docker-compose falls back to the local ./data-* defaults.
DATA_V11_1=/path/to/alerts-data-v11_1
DATA_V11=/path/to/alerts-data-v11
DATA_V10=/path/to/alerts-data-v10

# To expose the file server to other internal hosts, don't edit the committed compose —
# add the extra port bind in a gitignored docker-compose.override.yml, e.g.:
#   services:
#     file_server:
#       ports:
#         - "10.x.x.x:3546:80"
